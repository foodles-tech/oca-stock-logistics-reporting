<odoo>
    <template id="report_picking" inherit_id="stock.report_picking">
        <xpath expr="//tr[@t-foreach][@t-as='ml']" position="attributes">
            <attribute
                name="t-foreach"
            >o.move_line_ids_without_package.sorted(lambda ml: ml.location_id.id)</attribute>
        </xpath>
    </template>
</odoo>
